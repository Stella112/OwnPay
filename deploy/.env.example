# OwnPay VPS config. Copy to .env and edit. These are PUBLIC values (no secrets):
# the deployer private key is NEVER used here — it only signs the one-time contract
# deploy from your own machine.

# Required once the StockVesting contract is deployed to Base mainnet.
# Until this is set, the app runs and honestly shows "Not configured yet".
NEXT_PUBLIC_STOCK_VESTING_ADDRESS=

# The official AAPLc/NVDAc addresses are already baked into the app. Only set these
# to override (they are inlined at build time).
# NEXT_PUBLIC_AAPLC_ADDRESS=
# NEXT_PUBLIC_NVDAC_ADDRESS=

# Optional: your own Base RPC endpoint (defaults to https://mainnet.base.org).
# NEXT_PUBLIC_BASE_RPC_URL=

# Optional: verified Base Basename universal resolver (enables *.base.eth names).
# NEXT_PUBLIC_BASENAME_UNIVERSAL_RESOLVER=

# Caddy site address.
#   :80                 -> HTTP only, on the VPS IP (use while DNS is not yet pointed)
#   ownpay.example.com  -> automatic HTTPS once the domain points at this VPS
OWNPAY_DOMAIN=:80
