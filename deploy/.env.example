# OwnPay VPS config. Copy to .env and edit. These are PUBLIC values (no secrets):
# the deployer private key is NEVER used here — it only signs the one-time contract
# deploy from your own machine.

# Required once the StockVesting contract is deployed to Base mainnet.
# Until this is set, the app runs and honestly shows "Not configured yet".
NEXT_PUBLIC_STOCK_VESTING_ADDRESS=

# Canonical host used for OwnPay Links, QR codes, copy, share, and downloads.
NEXT_PUBLIC_APP_URL=https://ownpay.online

# The official Coinbase B20 stock addresses are already baked into the app.
# These overrides are for local testing only (they are inlined at build time).
# NEXT_PUBLIC_AAPLC_ADDRESS=
# NEXT_PUBLIC_NVDAC_ADDRESS=

# Optional: your own Base RPC endpoint (defaults to https://mainnet.base.org).
# NEXT_PUBLIC_BASE_RPC_URL=

# Optional: verified Base Basename universal resolver (enables *.base.eth names).
# NEXT_PUBLIC_BASENAME_UNIVERSAL_RESOLVER=

# Privy embedded-wallet auth. The current production path uses normal wallet
# transactions; users need Base ETH for gas. The app never stores user private
# keys on this VPS.
# NEXT_PUBLIC_PRIVY_APP_ID=
# Server-side identity-token verification key from Privy App settings → Basics.
# PRIVY_VERIFICATION_KEY=
# Public key-quorum ID used by the frontend to add the agent signer to a user wallet.
# NEXT_PUBLIC_PRIVY_KEY_QUORUM_ID=
# Optional 2.0 rule interpreter. Keep these server-only; never prefix with NEXT_PUBLIC_.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
# OLLAMA_API_KEY=
# DATABASE_URL=postgresql://ownpay:<password>@127.0.0.1:5432/ownpay

# Caddy site address.
#   :80                 -> HTTP only, on the VPS IP (use while DNS is not yet pointed)
#   ownpay.example.com  -> automatic HTTPS once the domain points at this VPS
OWNPAY_DOMAIN=:80

# Shared VPS mode (Apex-safe): deploy-shared.sh binds only this loopback port.
# Keep it dedicated and do not reuse a port owned by another service.
OWNPAY_PORT=3102

# Isolated Ownership Agent worker. It observes and persists only; it is
# intentionally fail-closed until a verified venue and route executor are
# independently configured. These server-only Privy values are required for
# the future execution path and must never be prefixed with NEXT_PUBLIC_.
OWNPAY_AGENT_MODE=observe
# PRIVY_APP_SECRET=
# PRIVY_AUTHORIZATION_PRIVATE_KEY=
# PRIVY_KEY_QUORUM_ID=
# OWNPAY_B20_ROUTE_ENABLED=false
# OWNPAY_B20_VENUE=aerodrome
# OWNPAY_B20_ROUTER_ADDRESS=
# AGENT_RPC_URL=https://mainnet.base.org
# AGENT_CHAIN_ID=8453
# AGENT_START_BLOCK=
# AGENT_BLOCK_CHUNK=10
# AGENT_POLL_INTERVAL_MS=30000
