# Separate testnet configuration. NEVER change Base chain/token settings.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_OWNRULES_ADDRESS=
ROBINHOOD_DEMO_ADAPTER_ADDRESS=
ROBINHOOD_DEMO_ASSET_ADDRESS=
ROBINHOOD_DEPLOYMENT_BLOCK=
# Optional official ZeroDev project endpoint, created specifically for 46630.
# Restrict sponsorship in ZeroDev to the deployed router/token, callers, quotas
# and methods. Not enabled without a configured and verified project.
NEXT_PUBLIC_ROBINHOOD_ZERODEV_RPC=
# Separate, low-balance testnet signers; no real funds.
ROBINHOOD_RELAY_PRIVATE_KEY=
ROBINHOOD_SPONSORED_OWNERS=
ROBINHOOD_AGENT_PRIVATE_KEY=
ROBINHOOD_AGENT_ADDRESS=
ROBINHOOD_AGENT_MODE=observe
OWNPAY_ROBINHOOD_WEB_ROOT=/opt/ownpay/releases/robinhood-20261003/web
ROBINHOOD_AGENT_INTERVAL_MS=60000
ROBINHOOD_AGENT_STATE_FILE=/opt/ownpay/web/.robinhood-agent/state.json
ROBINHOOD_AGENT_HEALTH_FILE=/opt/ownpay/web/.robinhood-agent/health.json
