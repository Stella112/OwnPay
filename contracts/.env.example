# Copy to .env and fill in. NEVER commit the real .env.
# The private key funds gas for deployment only. Use a dedicated deployer key,
# not a personal wallet holding significant funds.
DEPLOYER_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org
# Etherscan v2 multichain key (works for Basescan verification).
BASESCAN_API_KEY=
